; ============================================================
; {{TITLE}} · 账本入口
; 校验：python3 scripts/ledger.py check      网页报表（可选）：fava {{MAIN}}
; 记账请用 python3 scripts/ledger.py add {{NAME}}，它会在文件末尾自动追加每月序时簿的 include。
; ============================================================
option "title" "{{TITLE}}"
option "operating_currency" "{{CURRENCY}}"

include "common/commodities.beancount"
include "common/prices.beancount"
include "{{NAME}}/accounts.beancount"
include "{{NAME}}/opening.beancount"
